# Set these in the API hosting service's environment settings.
# Never copy the frontend environment or expose these values as NEXT_PUBLIC_*.
NODE_ENV=production
DATABASE_URL="postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require"
FRONTEND_URL=https://brewlite-frontend.vercel.app
JWT_SECRET=

# Render Free: deliver mail over HTTPS instead of outbound SMTP.
MAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=BrewLite

# Chỉ dùng giá trị thật trong Environment của Render.
SEPAY_API_KEY=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NO=
SEPAY_ACCOUNT_NAME=

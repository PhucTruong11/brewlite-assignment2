# Giá trị công khai dùng khi build web trên Vercel.
NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=https://brewlite-api-omni.onrender.com

# Các biến bí mật chỉ đặt trong Environment của Render, không điền vào file này.
# DATABASE_URL=postgresql://<user>:<password>@<supabase-session-pooler>:5432/postgres?sslmode=require
# JWT_SECRET=<random-secret>
# BREVO_API_KEY=<secret>
# SEPAY_API_KEY=<secret>

# URL web production để Render cấu hình CORS.
FRONTEND_URL=https://brewlite-frontend.vercel.app

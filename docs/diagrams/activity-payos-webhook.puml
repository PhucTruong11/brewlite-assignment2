@startuml activity-payos-webhook
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
|Next.js UI|
start
:Hỏi trạng thái đơn;
|NestJS API|
if (Đơn chưa có link PayOS?) then (Có)
  :Kiểm tra và giữ voucher đổi điểm nếu có;
  if (Có thể cấp QR?) then (Có)
    :Tạo và lưu link PayOS;
  else (Không)
    :Báo lỗi và không cấp QR;
    stop
  endif
endif
|Next.js UI|
:Hiển thị QR khi lấy được link;
|Khách hàng|
:Quét QR và chuyển khoản;
|NestJS API|
if (Tín hiệu đang xử lý là webhook?) then (Có)
  :Xác minh chữ ký trong payload\nvà đối chiếu giao dịch với đơn;
else (Không)
  :Polling hoặc tác vụ hết hạn\nđối soát link qua PayOS;
endif
if (Đã nhận đủ tiền và đơn đủ điều kiện hoàn tất?) then (Có)
  :Ghi PAID, trừ tồn, dùng voucher\nvà cộng điểm trong một transaction;
else (Không)
  if (Tác vụ hết hạn xác nhận link đã đóng
và chưa nhận tiền?) then (Có)
    :Hủy đơn, trả lượng giữ và nhả voucher;
  else (Không)
    :Giữ trạng thái hoặc báo cần đối soát;
  endif
endif
|Next.js UI|
:Đọc trạng thái và hiển thị kết quả;
stop
@enduml

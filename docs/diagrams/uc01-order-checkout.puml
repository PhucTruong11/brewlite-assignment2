@startuml
!pragma layout smetana
left to right direction
scale 1.8

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam ArrowColor #315C48
skinparam actor {
  FontColor #183D2B
  BorderColor #315C48
}
skinparam usecase {
  BackgroundColor #F4FAF6
  BorderColor #315C48
  FontColor #183D2B
}
skinparam rectangle {
  BackgroundColor white
  BorderColor #839B8B
  FontColor #183D2B
}

actor "Khách hàng" as Customer
actor "PayOS\n(webhook)" as PayOS

rectangle "BrewLite — UC-01: Đặt và thanh toán đơn hàng" {
  usecase "Đặt và thanh toán\nđơn hàng" as UC
  usecase "Kiểm tra giỏ, giá\nvà nguyên liệu" as Validate
  usecase "Tạo đơn PENDING\nvà giữ nguyên liệu" as Create
  usecase "Thanh toán thẻ\n(mô phỏng)" as Card
  usecase "Xác nhận VietQR\nqua PayOS" as QR
  usecase "Hủy đơn hết hạn\nvà trả nguyên liệu" as Expire
  usecase "Xem trạng thái\nvà biên nhận" as Receipt
}

Customer -- UC
Customer -- Receipt
PayOS -- QR

UC ..> Validate : <<include>>
UC ..> Create : <<include>>
Card ..> UC : <<extend>>\n[chọn thẻ]
QR ..> UC : <<extend>>\n[chọn VietQR]
Expire ..> UC : <<extend>>\n[hết hạn]

@enduml

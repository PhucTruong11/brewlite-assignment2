<mxfile host="app.diagrams.net" pages="2">
  <diagram name="Page-1" id="uaUiKZX4-EYvslX1TkD3">
    <mxGraphModel dx="4371" dy="3043" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor Khach as Khách hàng\n    participant Cart as CartContent.tsx\n    participant Inventory as inventory.service.ts\n    participant Orders as orders.service.ts\n    participant DB as PostgreSQL\n    participant Checkout as checkout/page.tsx\n    participant Payment as checkout.service.ts\n    participant SePay as SePay\n\n    Khach-&gt;&gt;Cart: Chọn món, size, topping và bấm Tiến hành thanh toán\n    Cart-&gt;&gt;Inventory: POST /api/cart/validate\n    Inventory-&gt;&gt;DB: Đọc món, giá, công thức và nguyên liệu\n    Inventory--&gt;&gt;Cart: Kết quả kiểm tra giỏ\n\n    alt Giỏ thiếu nguyên liệu hoặc dữ liệu đã đổi\n        Cart--&gt;&gt;Khach: Báo lỗi và yêu cầu sửa giỏ\n    else Giỏ hợp lệ, khách đã đăng nhập\n        Cart-&gt;&gt;Orders: POST /api/orders với items và promoCode\n        Orders-&gt;&gt;Inventory: Tính lại giá và nhu cầu nguyên liệu\n        Orders-&gt;&gt;DB: Transaction kiểm tra lại và tăng reserved\n        Orders-&gt;&gt;DB: Lưu Order PENDING và OrderItem\n        Orders--&gt;&gt;Cart: HTTP 201, orderId, reservationExpiresAt\n        Cart-&gt;&gt;Checkout: Mở /checkout?orderId=...\n        Checkout-&gt;&gt;Payment: GET /api/checkout/status/:orderId mỗi 2 giây\n        Payment--&gt;&gt;Checkout: Trạng thái và hạn thanh toán\n\n        alt Chọn VietQR\n            Khach-&gt;&gt;SePay: Chuyển khoản theo QR và nội dung đơn\n            SePay-&gt;&gt;Payment: POST /api/checkout/sepay-webhook\n        else Chọn thẻ\n            Khach-&gt;&gt;Checkout: Xác nhận thanh toán\n            Checkout-&gt;&gt;Payment: POST /api/checkout với Idempotency-Key\n        end\n\n        alt Thanh toán thành công\n            Payment-&gt;&gt;DB: Lưu Payment SUCCESS, Order PAID\n            Payment-&gt;&gt;Inventory: Trừ onHand và giảm reserved\n            Payment-&gt;&gt;DB: Dùng voucher và cộng điểm\n            Payment--&gt;&gt;Checkout: Trạng thái PAID\n            Checkout--&gt;&gt;Khach: Hiện hóa đơn và mã đơn\n        else Thanh toán lỗi nhưng còn hạn\n            Payment-&gt;&gt;DB: Order PAYMENT_FAILED\n            Payment--&gt;&gt;Checkout: Cho thử lại trong thời hạn\n        else Hết hạn 2 phút\n            Payment-&gt;&gt;Inventory: Nhả reserved\n            Payment-&gt;&gt;DB: Order CANCELLED\n            Checkout--&gt;&gt;Khach: Cho tạo lại tối đa một lượt\n            Khach-&gt;&gt;Checkout: Bấm tạo lại\n            Checkout-&gt;&gt;Orders: POST /api/orders từ giỏ hiện tại\n            Orders--&gt;&gt;Checkout: orderId mới nếu vẫn đủ nguyên liệu\n        end\n    end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="Y2M2MFyH29BE9PH0GsK3-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;labelBackgroundColor=none;" vertex="1">
